! DESCRIP.MMS - build PCRE2 (8-bit, Unicode, no JIT) for OpenVMS IA64 / x86-64
!
! Run via [.VMS]BUILD.COM, which passes ARCH and creates the output
! directories.  Source lists and per-object rules come from [.VMS]SOURCES.MMS,
! generated by tools/prepare.sh on the host.
!
! Outputs:
!   [.OBJ_<arch>]PCRE2-8.OLB          the library
!   [.OBJ_<arch>]PCRE2-POSIX.OLB      the POSIX wrapper (regcomp/regexec style)
!   [.BIN_<arch>]PCRE2TEST.EXE        the test program
!   [.INSTALL_<arch>.INCLUDE]         PCRE2.H, PCRE2POSIX.H  (install tree used
!   [.INSTALL_<arch>.LIB]             PCRE2-8.OLB, PCRE2-POSIX.OLB  by other ports)

.IFDEF ARCH
.ELSE
ARCH = IA64
.ENDIF

OBJ = [.OBJ_$(ARCH)]
LOBJ = [.OBJ_$(ARCH).LIB]
POBJ = [.OBJ_$(ARCH).POSIX]
BIN = [.BIN_$(ARCH)]
INST = [.INSTALL_$(ARCH)

.INCLUDE [.VMS]SOURCES.MMS

CC = CC
! The libraries are built for 8-bit code units; pcre2test chooses its own.
CFLAGS = $(CC_QUAL)/NOLIST/INCLUDE_DIRECTORY=("./src")/DEFINE=($(CC_DEFS),HAVE_CONFIG_H)
LIB_CFLAGS = $(CC_QUAL)/NOLIST/INCLUDE_DIRECTORY=("./src")-
	/DEFINE=($(CC_DEFS),HAVE_CONFIG_H,PCRE2_CODE_UNIT_WIDTH=8)

LIB = $(OBJ)PCRE2-8.OLB
PLIB = $(OBJ)PCRE2-POSIX.OLB

ALL : $(LIB), $(PLIB), $(BIN)PCRE2TEST.EXE, INSTALL_TREE
	@ CONTINUE

INSTALL_TREE : $(INST).LIB]PCRE2-8.OLB, $(INST).LIB]PCRE2-POSIX.OLB, -
	$(INST).INCLUDE]PCRE2.H, $(INST).INCLUDE]PCRE2POSIX.H
	@ CONTINUE

$(LIB) : $(LIB_OBJS)
	IF F$SEARCH("$(MMS$TARGET)") .EQS. "" THEN LIBRARY/CREATE/OBJECT $(MMS$TARGET)
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(LOBJ)*.OBJ

$(PLIB) : $(POSIX_OBJS)
	IF F$SEARCH("$(MMS$TARGET)") .EQS. "" THEN LIBRARY/CREATE/OBJECT $(MMS$TARGET)
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(POBJ)*.OBJ

$(BIN)PCRE2TEST.EXE : $(TEST_OBJS), $(PLIB), $(LIB)
	LINK/EXECUTABLE=$(MMS$TARGET)/MAP=$(OBJ)PCRE2TEST.MAP $(TEST_OBJS), $(PLIB)/LIBRARY, $(LIB)/LIBRARY

$(INST).LIB]PCRE2-8.OLB : $(LIB)
	COPY $(MMS$SOURCE) $(MMS$TARGET)

$(INST).LIB]PCRE2-POSIX.OLB : $(PLIB)
	COPY $(MMS$SOURCE) $(MMS$TARGET)

$(INST).INCLUDE]PCRE2.H : [.SRC]PCRE2.H
	COPY $(MMS$SOURCE) $(MMS$TARGET)

$(INST).INCLUDE]PCRE2POSIX.H : [.SRC]PCRE2POSIX.H
	COPY $(MMS$SOURCE) $(MMS$TARGET)

CLEAN :
	IF F$SEARCH("$(LOBJ)*.*") .NES. "" THEN DELETE/NOLOG $(LOBJ)*.*;*
	IF F$SEARCH("$(POBJ)*.*") .NES. "" THEN DELETE/NOLOG $(POBJ)*.*;*
	IF F$SEARCH("$(OBJ)*.OBJ") .NES. "" THEN DELETE/NOLOG $(OBJ)*.OBJ;*,*.OLB;*,*.MAP;*
	IF F$SEARCH("$(BIN)*.*") .NES. "" THEN DELETE/NOLOG $(BIN)*.*;*
